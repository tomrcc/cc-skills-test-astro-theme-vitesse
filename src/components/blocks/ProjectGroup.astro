---
import ListProjects from '@/components/ListProjects.vue'

const { title, projects } = Astro.props
---

<!-- mt-10 collapses with the heading above to the original 2.5rem gap. -->
<div class="project-group mt-10" mb-10>
  <h2 class="select-none relative h20 pointer-events-none">
    <span
      data-editable="text"
      data-prop="title"
      class="text-3.2em color-transparent font-bold text-stroke-1.5 text-stroke-hex-aaa op35 dark:op20 absolute top-0"
    >
      {title}
    </span>
  </h2>
  <ListProjects list={projects ?? []} />
</div>
